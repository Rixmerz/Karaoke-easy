{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karaoke Easy",
  "version": "2.0.0",
  "identifier": "com.karaokeeasy.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Karaoke Easy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
